# Git policy: Ignore all Markdown files except README.md
*.md
**/*.md
!README.md
!**/README.md

# Virtual environments
venv/
.venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.vitest/
coverage/

# Node & Frontend
node_modules/
.npm/
.vite/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
!*.example
*.pem
*.key

# Local databases and uploads
*.db
*.sqlite
*.sqlite3
backend/data/uploads/*
!backend/data/uploads/.gitkeep
data/uploads/*
!data/uploads/.gitkeep

# OS and IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
